{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "data",
  "id": "sabino-theme",
  "name": "Sabino Theme",
  "version": "1.2.0",
  "description": "A quiet Sonoran color scheme. Sabino Day (canyon sand) and Sabino Night (canyon green), for the app, the code editor and the terminal.",
  "author": { "name": "Catalina Automation", "url": "https://usecatalina.ai/sabino" },
  "repository": "https://github.com/Catalina-Automation/sabino-theme",
  "homepage": "https://usecatalina.ai/sabino",
  "license": "GPL-3.0-or-later",
  "engines": { "orca": ">=1.4.246" },
  "contributes": {
    "themes": [
      { "id": "sabino-day", "title": "Sabino Day", "path": "themes/sabino-day.json" },
      { "id": "sabino-night", "title": "Sabino Night", "path": "themes/sabino-night.json" }
    ],
    "terminalThemes": [
      { "id": "sabino-day", "title": "Sabino Day", "path": "themes/sabino-day-terminal.json" },
      { "id": "sabino-night", "title": "Sabino Night", "path": "themes/sabino-night-terminal.json" }
    ]
  }
}
